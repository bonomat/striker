{
  "name": "@satora/striker-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/taker-sdk",
    "apps/striker",
    "apps/maker",
    "apps/taker",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run build && tsc --noEmit",
    "striker": "node apps/striker/dist/cli.js",
    "maker": "node --experimental-eventsource apps/maker/dist/cli.js",
    "taker": "node --experimental-eventsource apps/taker/dist/cli.js",
    "test": "npm run build && tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "regtest": "node scripts/regtest.mjs",
    "test:e2e": "npm run build && node --experimental-eventsource --import tsx --test --test-concurrency=1 test/e2e/*.test.ts",
    "web": "npm run dev --workspace @satora/web"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.79",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.2.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
