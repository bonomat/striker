# Public local regtest configuration. Never use production keys or funds here.
REGTEST_PROJECT=striker-poc
REGTEST_CONTAINER_PREFIX=striker-poc-
REGTEST_PROFILES=emulator
AUTOMINE_INTERVAL=0
# Use seconds consistently: the CLI faucet otherwise treats the short default
# expiry as elapsed wall-clock time while the block scheduler waits for mining.
ARKD_VTXO_TREE_EXPIRY=86400
ARKD_UNILATERAL_EXIT_DELAY=1536
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=1536
ARKD_BOARDING_EXIT_DELAY=86400
ARKD_CHECKPOINT_EXIT_DELAY=1536

# Reusable taker covenants require the pinned Emulator with OP_TUNNEL.
EMULATOR_IMAGE=striker-emulator:v0.0.9-rc.2-striker.1
