+package application
+
+import (
+	"bytes"
+	"github.com/btcsuite/btcd/btcec/v2"
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/psbt/v2"
+	"github.com/btcsuite/btcd/wire/v2"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestMergeCheckpointSignatures(t *testing.T) {
+	sig := func(key, value byte) *psbt.TaprootScriptSpendSig {
+		_, pub := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{key}, 32))
+		return &psbt.TaprootScriptSpendSig{XOnlyPubKey: schnorr.SerializePubKey(pub), LeafHash: bytes.Repeat([]byte{2}, 32), Signature: bytes.Repeat([]byte{value}, 64)}
+	}
+	client, echo, server := sig(1, 3), sig(1, 3), sig(4, 5)
+	merged, err := mergeCheckpointSignatures([]*psbt.TaprootScriptSpendSig{client}, []*psbt.TaprootScriptSpendSig{echo, server})
+	require.NoError(t, err)
+	require.Len(t, merged, 2)
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{})
+	tx.AddTxOut(&wire.TxOut{Value: 330, PkScript: []byte{0x51}})
+	packet, err := psbt.NewFromUnsignedTx(tx)
+	require.NoError(t, err)
+	packet.Inputs[0].TaprootScriptSpendSig = merged
+	submitted := checkpointForSubmission(packet)
+	require.Empty(t, submitted.Inputs[0].TaprootScriptSpendSig)
+	require.Len(t, packet.Inputs[0].TaprootScriptSpendSig, 2, "submission must preserve the signatures needed for finalization")
+	encoded, err := packet.B64Encode()
+	require.NoError(t, err)
+	_, err = psbt.NewFromRawBytes(strings.NewReader(encoded), true)
+	require.NoError(t, err, "final checkpoint must parse without duplicate PSBT keys")
+	_, err = mergeCheckpointSignatures([]*psbt.TaprootScriptSpendSig{client}, []*psbt.TaprootScriptSpendSig{sig(1, 9)})
+	require.ErrorContains(t, err, "conflicting")
+}
