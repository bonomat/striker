+package application
+
+import (
+	"bytes"
+	"fmt"
+	"github.com/btcsuite/btcd/psbt/v2"
+)
+
+// arkd may echo client signatures as well as adding its own. BIP371 identifies
+// a tapscript signature by (x-only public key, leaf hash); duplicate keys make
+// the PSBT invalid even when both signature values are identical.
+func mergeCheckpointSignatures(groups ...[]*psbt.TaprootScriptSpendSig) ([]*psbt.TaprootScriptSpendSig, error) {
+	merged := make([]*psbt.TaprootScriptSpendSig, 0)
+	for _, group := range groups {
+		for _, candidate := range group {
+			if candidate == nil {
+				return nil, fmt.Errorf("nil tapscript signature")
+			}
+			found := false
+			for _, prior := range merged {
+				if bytes.Equal(prior.XOnlyPubKey, candidate.XOnlyPubKey) && bytes.Equal(prior.LeafHash, candidate.LeafHash) {
+					if prior.SigHash != candidate.SigHash || !bytes.Equal(prior.Signature, candidate.Signature) {
+						return nil, fmt.Errorf("conflicting tapscript signatures for the same PSBT key")
+					}
+					found = true
+					break
+				}
+			}
+			if !found {
+				merged = append(merged, candidate)
+			}
+		}
+	}
+	return merged, nil
+}
+
+func checkpointForSubmission(checkpoint *psbt.Packet) *psbt.Packet {
+	copy := *checkpoint
+	copy.Inputs = append([]psbt.PInput(nil), checkpoint.Inputs...)
+	for i := range copy.Inputs {
+		copy.Inputs[i].TaprootScriptSpendSig = nil
+	}
+	return &copy
+}
